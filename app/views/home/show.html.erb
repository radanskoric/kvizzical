<div class="w-full max-w-md mx-auto text-center">
  <h1 class="text-5xl font-extrabold tracking-tight text-gray-900 mb-2">Kvizzical</h1>
  <p class="text-lg text-gray-500 mb-10">Join a live quiz</p>

  <%= form_tag(nil, method: :get, id: "join-form", class: "space-y-4") do %>
    <input
      type="text"
      name="code"
      placeholder="Enter game code"
      required
      maxlength="6"
      autofocus
      class="w-full text-center text-2xl font-mono uppercase tracking-widest rounded-xl border-2 border-gray-300 px-4 py-3 focus:border-red-500 focus:ring-red-500 focus:outline-none"
    />
    <button type="submit" class="w-full rounded-xl bg-red-600 px-6 py-3 text-lg font-semibold text-white shadow-sm hover:bg-red-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600 transition">
      Join Game
    </button>
  <% end %>

  <div class="mt-12 pt-8 border-t border-gray-200 w-full">
    <h2 class="text-lg font-semibold text-gray-700 mb-4">Host a Quiz</h2>
    <div class="space-y-3">
      <% Quiz.all.each do |quiz| %>
        <%= link_to games_path(quiz_id: quiz.id), data: { turbo_method: :post }, class: "block w-full rounded-xl border-2 border-gray-200 bg-white px-6 py-4 text-lg font-medium text-gray-800 hover:border-red-500 hover:bg-red-50 transition text-left" do %>
          <span class="font-semibold"><%= quiz.title %></span>
          <span class="text-sm text-gray-500 ml-2"><%= quiz.questions.count %> questions</span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.getElementById("join-form").addEventListener("submit", function(e) {
    e.preventDefault();
    var code = this.querySelector("input[name='code']").value.trim().toUpperCase();
    if (code) { window.location.href = "/play/" + encodeURIComponent(code); }
  });
</script>
