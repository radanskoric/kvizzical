<div class="w-full max-w-md rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
  <div class="text-center">
    <h1 class="text-3xl font-bold text-gray-900">Create your account</h1>
    <p class="mt-2 text-sm text-gray-500">Register to host quizzes and keep your name when you play.</p>
  </div>

  <% if @user.errors.any? %>
    <div class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 space-y-1">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path, class: "mt-8 space-y-4" do |form| %>
    <div>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", placeholder: "Name", class: "w-full rounded-xl border-2 border-gray-300 px-4 py-3 text-base text-gray-900 focus:border-red-500 focus:outline-none focus:ring-red-500" %>
    </div>

    <div>
      <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "Email address", class: "w-full rounded-xl border-2 border-gray-300 px-4 py-3 text-base text-gray-900 focus:border-red-500 focus:outline-none focus:ring-red-500" %>
    </div>

    <div>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Password", maxlength: 72, class: "w-full rounded-xl border-2 border-gray-300 px-4 py-3 text-base text-gray-900 focus:border-red-500 focus:outline-none focus:ring-red-500" %>
    </div>

    <div>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm password", maxlength: 72, class: "w-full rounded-xl border-2 border-gray-300 px-4 py-3 text-base text-gray-900 focus:border-red-500 focus:outline-none focus:ring-red-500" %>
    </div>

    <%= form.submit "Create account", class: "w-full rounded-xl bg-red-600 px-6 py-3 text-lg font-semibold text-white shadow-sm hover:bg-red-500 transition" %>
  <% end %>

  <div class="mt-6 text-center text-sm text-gray-500">
    Already have an account?
    <%= link_to "Log in", new_session_path, class: "font-semibold text-red-600 hover:text-red-500" %>
  </div>
</div>
