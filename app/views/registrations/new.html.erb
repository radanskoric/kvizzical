<div class="form-card">
  <div class="text-center">
    <h1 class="page-title text-3xl">Create your account</h1>
    <p class="mt-2 text-sm text-gray-500">Register to host quizzes and keep your name when you play.</p>
  </div>

  <% if @user.errors.any? %>
    <div class="panel-danger mt-6 px-4 py-3 text-sm">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 space-y-1">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path, class: "mt-8 space-y-4" do |form| %>
    <div>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", placeholder: "Name", class: "text-input" %>
    </div>

    <div>
      <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "Email address", class: "text-input" %>
    </div>

    <div>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Password", maxlength: 72, class: "text-input" %>
    </div>

    <div>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm password", maxlength: 72, class: "text-input" %>
    </div>

    <%= form.submit "Create account", class: "btn btn-primary w-full px-6 py-3 text-lg shadow-sm" %>
  <% end %>

  <div class="mt-6 text-center text-sm text-gray-500">
    Already have an account?
    <%= link_to "Log in", new_session_path, class: "font-semibold text-red-600 hover:text-red-500" %>
  </div>
</div>
