<div class="page-shell max-w-md">
  <% if @user.nil? %>
    <h1 class="page-title text-3xl mb-2"><%= @game.quiz.title %></h1>
    <p class="text-gray-500 mb-8">Enter your name to join</p>

    <%= form_tag(play_path(code: @game.code), method: :post, class: "space-y-4") do %>
      <input
        type="text"
        name="name"
        placeholder="Your name"
        required
        autofocus
        class="text-input text-center text-xl"
      />
      <button type="submit" class="btn btn-primary w-full px-6 py-3 text-lg shadow-sm">
        Join
      </button>
    <% end %>
  <% else %>
    <%= turbo_stream_from "game_#{@game.id}_player_#{@user.id}" %>
    <%= render "play/game_area", game: @game, participant: @participant %>
  <% end %>
</div>
