<div class="w-full max-w-md mx-auto text-center">
  <% if @user.nil? %>
    <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @game.quiz.title %></h1>
    <p class="text-gray-500 mb-8">Enter your name to join</p>

    <%= form_tag(play_path(code: @game.code), method: :post, class: "space-y-4") do %>
      <input
        type="text"
        name="name"
        placeholder="Your name"
        required
        autofocus
        class="w-full text-center text-xl rounded-xl border-2 border-gray-300 px-4 py-3 focus:border-red-500 focus:ring-red-500 focus:outline-none"
      />
      <button type="submit" class="w-full rounded-xl bg-red-600 px-6 py-3 text-lg font-semibold text-white shadow-sm hover:bg-red-500 transition">
        Join
      </button>
    <% end %>
  <% else %>
    <%= turbo_stream_from "game_#{@game.id}_player_#{@user.id}" %>
    <%= render "play/game_area", game: @game, participant: @participant %>
  <% end %>
</div>
