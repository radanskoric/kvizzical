<% if question.references.any? %>
  <details class="rounded-xl border border-gray-200 bg-gray-50 p-4 mb-4">
    <summary class="cursor-pointer text-sm font-medium uppercase tracking-wide text-gray-500">References</summary>
    <div class="mt-3 space-y-2">
      <% question.references.each do |reference| %>
        <div>
          <%= link_to reference.url, reference.url, target: "_blank", rel: "noopener noreferrer", class: "break-all text-sm text-red-600 underline hover:text-red-500" %>
        </div>
      <% end %>
    </div>
  </details>
<% end %>
