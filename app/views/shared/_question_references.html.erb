<% if question.references.any? %>
  <details class="panel-subtle p-4 mb-4">
    <summary class="section-eyebrow cursor-pointer">References</summary>
    <div class="mt-3 space-y-2">
      <% question.references.each do |reference| %>
        <div>
          <%= link_to reference.url, reference.url, target: "_blank", rel: "noopener noreferrer", class: "break-all text-sm text-red-600 underline hover:text-red-500" %>
        </div>
      <% end %>
    </div>
  </details>
<% end %>
