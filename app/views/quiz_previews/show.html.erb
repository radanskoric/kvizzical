<div class="page-shell max-w-2xl">
  <div class="panel p-8 space-y-6">
    <div>
      <p class="section-eyebrow mb-2">Quiz Preview</p>
      <h1 class="page-title text-4xl font-extrabold tracking-tight"><%= @quiz.title %></h1>
    </div>

    <p class="text-lg text-gray-600">This is a preview view of the quiz, so you can step through the questions on your own without joining a live game.</p>

    <div class="panel-subtle px-6 py-5">
      <p class="section-eyebrow">Questions</p>
      <p class="mt-2 text-3xl font-bold text-gray-900"><%= pluralize(@quiz.questions.count, "question") %></p>
    </div>

    <%= link_to "Start Quiz", quiz_preview_question_path(secret_preview_token: @quiz.secret_preview_token, position: 1), class: "btn btn-primary inline-flex items-center justify-center px-8 py-4 text-xl shadow-sm" %>
  </div>
</div>
