<div id="preview_question_area" data-preview-status="active" class="w-full max-w-md mx-auto text-center">
  <div class="flex items-center justify-between mb-2">
    <p class="text-sm font-medium text-gray-500 uppercase tracking-wide"><%= @quiz.title %></p>
    <p class="text-3xl font-bold text-red-600"
       data-controller="countdown"
       data-countdown-seconds-value="<%= @question.time_limit_seconds %>"
       data-countdown-opened-at-value="<%= Time.current.iso8601(3) %>"
       data-countdown-redirect-url-value="<%= quiz_preview_answer_path(secret_preview_token: @quiz.secret_preview_token, position: @question.position, answer_position: @timeout_answer_position) %>">
    </p>
  </div>

  <h2 class="text-2xl font-bold text-gray-900 mb-6" data-question-body><%= render_question(@question) %></h2>

  <div id="answer_area" class="space-y-3">
    <% @answers.each_with_index do |answer, index| %>
      <%= link_to quiz_preview_answer_path(secret_preview_token: @quiz.secret_preview_token, position: @question.position, answer_position: index + 1, answered_index: index + 1), class: "block w-full rounded-xl border-2 border-gray-200 bg-white px-6 py-4 text-lg font-medium text-gray-800 hover:border-red-500 hover:bg-red-50 transition" do %>
        <%= answer.body %>
      <% end %>
    <% end %>
  </div>
</div>
