<div id="preview_question_area" data-preview-status="active" class="page-shell max-w-md">
  <div class="flex items-center justify-between mb-2">
    <p class="section-eyebrow"><%= @quiz.title %></p>
    <p class="countdown-display text-3xl"
       data-controller="countdown"
       data-countdown-seconds-value="<%= @question.time_limit_seconds %>"
       data-countdown-opened-at-value="<%= Time.current.iso8601(3) %>"
       data-countdown-redirect-url-value="<%= quiz_preview_answer_path(secret_preview_token: @quiz.secret_preview_token, position: @question.position, answer_position: @timeout_answer_position) %>">
    </p>
  </div>

  <h2 class="page-title text-2xl mb-6" data-question-body><%= render_question(@question) %></h2>

  <div id="answer_area" class="space-y-3">
    <% @answers.each_with_index do |answer, index| %>
      <%= link_to quiz_preview_answer_path(secret_preview_token: @quiz.secret_preview_token, position: @question.position, answer_position: index + 1, answered_index: index + 1), class: "answer-option answer-option-idle block" do %>
        <%= answer.body %>
      <% end %>
    <% end %>
  </div>
</div>
