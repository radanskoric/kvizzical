<div class="page-shell max-w-2xl">
  <h1 class="page-title text-3xl mb-4"><%= @quiz.title %></h1>
  <div class="panel-subtle p-8 mb-6">
    <p class="text-2xl font-bold text-gray-900 mb-2">Preview complete!</p>
    <p class="text-gray-500">Thanks for previewing this quiz.</p>
  </div>
  <%= link_to "Start Again", quiz_preview_path(secret_preview_token: @quiz.secret_preview_token), class: "btn btn-secondary inline-flex items-center justify-center px-6 py-3 text-base" %>
</div>
