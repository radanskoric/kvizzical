<div id="preview_answer_area" data-preview-status="reviewing" class="page-shell max-w-md">
  <h2 class="page-title text-2xl mb-4"><%= render_question(@question) %></h2>

  <% if @selected_answer.nil? %>
    <p class="text-gray-500 mb-4">Time ran out before you selected an answer.</p>
  <% end %>

  <div class="space-y-3 mb-6 text-left">
    <% @answers.each_with_index do |answer, index| %>
      <% is_correct = answer.correct? %>
      <% was_chosen = @selected_answer_position == index + 1 %>
      <div class="answer-option
        <%= if is_correct
              'answer-option-correct'
            elsif was_chosen
              'answer-option-incorrect'
            else
              'answer-option-muted'
            end %>">
        <%= answer.body %>
        <% if is_correct %>
          <span class="ml-2 text-green-600 font-bold">&check;</span>
        <% elsif was_chosen %>
          <span class="ml-2 text-red-600 font-bold">&cross;</span>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= render "shared/question_references", question: @question %>

  <% if @next_question %>
    <%= link_to "Next Question", quiz_preview_question_path(secret_preview_token: @quiz.secret_preview_token, position: @next_question.position), class: "btn btn-primary inline-flex items-center justify-center px-8 py-4 text-xl shadow-sm" %>
  <% else %>
    <%= link_to "Finish Preview", quiz_preview_end_path(secret_preview_token: @quiz.secret_preview_token), class: "btn btn-primary inline-flex items-center justify-center px-8 py-4 text-xl shadow-sm" %>
  <% end %>
</div>
