<div id="game_host_area" data-version="<%= game.lock_version %>">
  <% if game.waiting? %>
    <div class="panel p-8 mb-6 space-y-6">
      <div>
        <p class="section-eyebrow mb-1">Game Code</p>
        <p class="game-code text-5xl" data-game-code><%= game.code %></p>
      </div>

      <div>
        <p class="section-eyebrow mb-2">Scan to Join</p>
        <%= qr_code_svg(play_url(code: game.code), size: 200) %>
      </div>

      <div id="player_list">
        <%= render "games/player_list", game: game %>
      </div>

      <%= form_with url: start_game_path(game), method: :post, class: "pt-4" do %>
        <button type="submit" class="btn btn-success px-8 py-4 text-xl shadow-sm">
          Start Quiz
        </button>
      <% end %>
    </div>

  <% elsif game.active? && game.current_question %>
    <div class="mb-6 flex flex-col gap-6 xl:flex-row xl:items-start">
      <div class="panel p-8 space-y-6 xl:w-80 xl:flex-none">
        <div>
          <p class="section-eyebrow mb-1">Game Code</p>
          <p class="game-code text-3xl" data-game-code><%= game.code %></p>
        </div>

        <div>
          <p class="section-eyebrow mb-2">Scan to Join</p>
          <%= qr_code_svg(play_url(code: game.code), size: 200) %>
        </div>
      </div>

      <div class="panel p-8 space-y-6 xl:min-w-0 xl:flex-1">
        <div>
          <p class="section-eyebrow mb-1">Players</p>
          <p class="text-2xl font-bold text-gray-900" data-player-count><%= game.participants.count %></p>
        </div>

        <div>
          <p class="section-eyebrow mb-1">Time Remaining</p>
          <p class="countdown-display text-4xl"
             data-controller="countdown"
             data-countdown-seconds-value="<%= game.current_question.time_limit_seconds %>"
             data-countdown-opened-at-value="<%= game.question_opened_at.iso8601(3) %>"
             data-countdown-finish-url-value="<%= finish_question_game_path(game) %>">
          </p>
        </div>

        <div>
          <p class="section-eyebrow mb-2">Current Question</p>
          <p class="text-xl font-semibold text-gray-900"><%= render_question(game.current_question) %></p>
        </div>

        <div>
          <p class="section-eyebrow mb-1">Responses</p>
          <p class="text-2xl font-bold text-gray-900" data-response-count><%= Response.where(participant: game.participants, question: game.current_question).count %> / <%= game.participants.count %></p>
        </div>

        <%= form_with url: finish_question_game_path(game), method: :post, class: "pt-2" do %>
          <button type="submit" class="btn btn-warning px-8 py-4 text-xl shadow-sm">
            Finish Question
          </button>
        <% end %>
      </div>

      <div class="xl:min-w-0 xl:flex-1">
        <%= render "shared/leaderboard", game: game %>
      </div>
    </div>

  <% elsif game.reviewing? && game.current_question %>
    <% question = game.current_question %>
    <% correct_answer = question.answers.find_by(correct: true) %>
    <div class="mb-6 flex flex-col gap-6 xl:flex-row xl:items-start">
      <div class="panel p-8 space-y-6 xl:w-80 xl:flex-none">
        <div>
          <p class="section-eyebrow mb-1">Game Code</p>
          <p class="game-code text-3xl" data-game-code><%= game.code %></p>
        </div>

        <div>
          <p class="section-eyebrow mb-2">Scan to Join</p>
          <%= qr_code_svg(play_url(code: game.code), size: 200) %>
        </div>
      </div>

      <div class="panel p-8 space-y-6 xl:min-w-0 xl:flex-1">
        <div>
          <p class="section-eyebrow mb-2">Question (<%= question.position %>/<%= game.quiz.questions.count %>)</p>
          <p class="text-xl font-semibold text-gray-900"><%= render_question(question) %></p>
        </div>

        <div>
          <p class="section-eyebrow mb-2">Correct Answer</p>
          <div class="answer-option answer-option-correct">
            <p class="text-lg font-bold text-green-700"><%= correct_answer&.body %></p>
          </div>
        </div>

        <%= render "shared/question_references", question: question %>

        <% next_question = game.quiz.questions.order(:position).where("position > ?", question.position).first %>
        <%= form_with url: advance_game_path(game), method: :post, class: "pt-2" do %>
          <button type="submit" class="btn btn-primary px-8 py-4 text-xl shadow-sm">
            <%= next_question ? "Next Question" : "Show Results" %>
          </button>
        <% end %>
      </div>

      <div class="xl:min-w-0 xl:flex-1">
        <%= render "shared/leaderboard", game: game %>
      </div>
    </div>

  <% elsif game.finished? %>
    <div class="panel p-8 mb-6 space-y-6">
      <div>
        <p class="section-eyebrow mb-1">Game Code</p>
        <p class="game-code text-3xl" data-game-code><%= game.code %></p>
      </div>

      <div>
        <p class="section-eyebrow mb-1">Players</p>
        <p class="text-2xl font-bold text-gray-900" data-player-count><%= game.participants.count %></p>
      </div>

      <p class="text-xl text-gray-600 mt-2">Game Over</p>
    </div>

    <%= render "shared/leaderboard", game: game %>
  <% end %>
</div>
