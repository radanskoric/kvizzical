<div id="player_list">
  <p class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-1">Players Joined</p>
  <p class="text-3xl font-bold text-gray-900" data-player-count><%= game.participants.count %></p>
  <% if game.participants.any? %>
    <div class="flex flex-wrap justify-center gap-2 mt-3">
      <% game.participants.includes(:user).each do |participant| %>
        <span class="inline-block rounded-full bg-indigo-100 px-3 py-1 text-sm font-medium text-indigo-700"><%= participant.name %></span>
      <% end %>
    </div>
  <% end %>
</div>
